{
  "compilerOptions": {
    "importHelpers": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "target": "ES2018",
    "strict": true,
    "verbatimModuleSyntax": true,
    "declaration": false,
    "sourceMap": false,
    "declarationMap": false,
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.js", "src/**/*.jsx"],
  "exclude": ["node_modules", "dist"]
}
